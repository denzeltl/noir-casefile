# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_primary_groq_api_key_here

# Optional backup key (used automatically if primary key hits rate limits or errors)
# GROQ_API_KEY_BACKUP=gsk_your_backup_groq_api_key_here

# Site URL for canonical meta tags & social previews (optional for local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Ad Studio (optional; the game works without these) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server only, never in the browser
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
GOOGLE_API_KEY=your_gemini_api_key
ADMIN_PASSWORD=change_me
N8N_SHARED_SECRET=long_random_string
# Render worker (scripts/render-worker.ts): where to resume runs. Your Vercel URL, or http://localhost:3000
AD_STUDIO_URL=https://your-site.vercel.app
# n8n's URL is saved in the database by n8n's tunnel-sync container. Set this only to override it.
# N8N_BASE_URL=http://localhost:5678
# Optional model overrides for the ad pipeline (defaults in src/lib/ads/models.ts)
# AD_WRITER_MODEL=openai/gpt-oss-120b
# AD_CRITIC_MODEL=gemini-3.5-flash-lite
