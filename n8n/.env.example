# n8n runtime config. Copy to n8n/.env (gitignored) and fill in. Read by n8n/docker-compose.yml.

# Only used for URLs shown in the n8n editor; the quick tunnel URL is handled by tunnel-sync.
WEBHOOK_URL=http://localhost:5678/
N8N_PORT=5678
# Only for the optional named tunnel (`--profile named`).
CLOUDFLARE_TUNNEL_TOKEN=
# Workflows read the values below through $env.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Your timezone, for schedule triggers.
GENERIC_TIMEZONE=UTC

# The Noir Casefile app n8n calls: the local dev server, or your live domain once deployed.
AD_STUDIO_URL=http://host.docker.internal:3000
# Same value as N8N_SHARED_SECRET in the app's env.
N8N_SHARED_SECRET=long_random_string

# Telegram bot from @BotFather, and your own chat id (message @userinfobot to get it).
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Random string; Telegram echoes it on every button tap so WF2 can reject forgeries.
TELEGRAM_WEBHOOK_SECRET=another_long_random_string
